# ============================================
# AI Agent 自动化工作流平台 - 环境配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# LLM API 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek API 配置（可选）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 当前使用的 LLM 提供商
LLM_PROVIDER=openai

# FastAPI 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ChromaDB 配置
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=agent_memory
MEMORY_MAX_TURNS=20
MEMORY_SIMILARITY_TOP_K=5

# 任务配置
MAX_RETRIES=3
RETRY_DELAY=2
TASK_TIMEOUT=300

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs
