# ============================================================
# llm-agent-projects — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# Each project may override these with its own .env file.
# ============================================================

# ---- LLM API (used by 02, 03, 04, 06, 07, 09, 11, 12, 14, 16, 18, 19) ----
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Vision API (used by 09-multimodal-doc-understanding) ----
VISION_PROVIDER=openai          # "openai" for real, "mock" for testing
VISION_MODEL=gpt-4o
# Set ALLOW_MOCK_PROVIDERS=true only for local testing without API keys
# ALLOW_MOCK_PROVIDERS=true

# ---- Memory Consolidator (used by 18-agent-long-term-memory) ----
CONSOLIDATOR_PROVIDER=openai    # "openai" for LLM-based, "keyword" for simple clustering

# ---- Voice (used by 19-voice-ai-assistant) ----
ASR_PROVIDER=whisper            # "whisper" for real, "mock" for testing
TTS_PROVIDER=edge-tts           # "edge-tts" for real, "mock" for testing
WHISPER_MODEL=base              # tiny/base/small/medium/large
WHISPER_DEVICE=cpu              # cpu or cuda
TTS_VOICE=zh-CN-XiaoxiaoNeural  # edge-tts voice name
# Set ALLOW_MOCK_PROVIDERS=true only for local testing
# ALLOW_MOCK_PROVIDERS=true

# ---- API Auth (used by 03, 04, 15) ----
# Set to "true" for local development (disables auth checks)
# GATEWAY_AUTH_DISABLED=true
# GUARDRAILS_AUTH_DISABLED=true
# SANDBOX_AUTH_DISABLED=true

# ---- LoRA Fine-tuning (used by 06-lora-finetune) ----
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct   # or any HuggingFace model
# SKIP_HEAVY_TESTS=1                    # skip torch-heavy tests

# ---- HuggingFace Network (国内必设) ----
# HF_ENDPOINT=https://hf-mirror.com       # 国内访问 HuggingFace 镜像（推荐）
# HF_HOME=F:\hf_cache                    # 模型下载到 F 盘（C 盘不要放）
# TRANSFORMERS_CACHE=F:\hf_cache
# HUGGINGFACE_HUB_CACHE=F:\hf_cache

# ---- Prompt Eval Framework (used by 12-prompt-eval-framework) ----
# SKIP_HF_DOWNLOAD=1                    # skip HuggingFace downloads in tests

# ---- ChromaDB / Vector DB (used by 01, 02, 05) ----
# CHROMA_PERSIST_DIR=./chroma_data
